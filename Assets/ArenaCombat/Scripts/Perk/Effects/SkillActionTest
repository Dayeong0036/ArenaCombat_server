/*
Standalone scratchpad for wrapper-based skill execution design.
This file is intentionally isolated and not referenced by runtime code.

Goal:
- Show how TriggerOnCondition can receive "functions" and execute them as wrappers.
- Keep everything in one file so it does not affect the current project structure.

Important:
- This is a prototype shape, not production-ready game code.
- For a real data-driven system, delegates are useful for testing, but ScriptableObject
  nodes or serializable action/condition definitions are safer for editor workflows.
*/

using System;
using System.Collections.Generic;

public static class SkillActionTest
{
    public sealed class SkillContext
    {
        public bool LastHitLanded;
        public bool TargetBelowExecuteThreshold;
        public float TargetCurrentHpPercent;
        public readonly List<string> Log = new();

        public void AddLog(string message)
        {
            Log.Add(message);
        }
    }

    public delegate void SkillStep(SkillContext context);
    public delegate bool SkillCondition(SkillContext context);

    public static SkillStep Sequence(params SkillStep[] steps)
    {
        return context =>
        {
            if (steps == null)
            {
                return;
            }

            for (int i = 0; i < steps.Length; i++)
            {
                steps[i]?.Invoke(context);
            }
        };
    }

    public static SkillStep TriggerOnCondition(
        string name,
        SkillCondition condition,
        SkillStep onTrue,
        SkillStep onFalse = null)
    {
        return context =>
        {
            bool passed = condition != null && condition(context);
            context.AddLog($"[Condition] {name} => {passed}");

            if (passed)
            {
                onTrue?.Invoke(context);
                return;
            }

            onFalse?.Invoke(context);
        };
    }

    public static SkillStep TriggerOnHit(SkillStep onHit, SkillStep onMiss = null)
    {
        return TriggerOnCondition(
            "OnHit",
            context => context.LastHitLanded,
            onHit,
            onMiss);
    }

    public static SkillStep DealDamage(float amount)
    {
        return context => context.AddLog($"DealDamage({amount})");
    }

    public static SkillStep DealMultiHitDamage(float amount, int hitCount)
    {
        return context =>
        {
            for (int i = 0; i < hitCount; i++)
            {
                context.AddLog($"DealMultiHitDamage({amount}) hit {i + 1}/{hitCount}");
            }
        };
    }

    public static SkillStep DealDirectionalHit(float damage, float range, float angle)
    {
        return context =>
        {
            context.AddLog($"DealDirectionalHit(dmg:{damage}, range:{range}, angle:{angle})");

            /*
            For testing only:
            - Treat narrow angles as "core hit"
            - Treat wide angles as fallback hit
            This is just to demonstrate wrapper flow in one file.
            */
            context.LastHitLanded = angle <= 35f || range >= 2.4f;
        };
    }

    public static SkillStep ApplyVulnerability(float duration, float bonusPercent)
    {
        return context => context.AddLog($"ApplyVulnerability({duration}s, +{bonusPercent}%)");
    }

    public static SkillStep ExecuteBelowHP(float hpPercent, float bonusDamage)
    {
        return TriggerOnCondition(
            $"ExecuteBelowHP <= {hpPercent}%",
            context => context.TargetCurrentHpPercent <= hpPercent || context.TargetBelowExecuteThreshold,
            DealDamage(bonusDamage));
    }

    public static SkillStep DealShieldBreakDamage(float amount, float multiplier)
    {
        return context => context.AddLog($"DealShieldBreakDamage({amount}, x{multiplier})");
    }

    public static SkillStep BuildExecuteSpike()
    {
        return Sequence(
            DealDirectionalHit(125f, 2.0f, 30f),
            TriggerOnHit(
                Sequence(
                    ApplyVulnerability(2f, 5f),
                    ExecuteBelowHP(30f, 20f)),
                Sequence(
                    DealDirectionalHit(125f, 2.4f, 70f)))
        );
    }

    public static SkillStep BuildCrushingCombo()
    {
        return Sequence(
            DealDirectionalHit(34f, 1.8f, 35f),
            TriggerOnHit(
                Sequence(
                    DealMultiHitDamage(34f, 4),
                    DealShieldBreakDamage(45f, 1.2f)),
                Sequence(
                    DealDirectionalHit(34f, 2.2f, 75f),
                    DealMultiHitDamage(34f, 4)))
        );
    }

    public static List<string> RunSample()
    {
        var context = new SkillContext
        {
            TargetCurrentHpPercent = 25f
        };

        SkillStep executeSpike = BuildExecuteSpike();
        SkillStep crushingCombo = BuildCrushingCombo();

        executeSpike(context);
        crushingCombo(context);

        return context.Log;
    }
}
